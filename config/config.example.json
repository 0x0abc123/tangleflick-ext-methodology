{
  "app": {
    "name": "tangleflick",
    "logLevel": "debug"
  },
  "bus": {
    "type": "emitter"
  },
  "store": {
    "type": "sqlite",
    "path": "./data/tangleflick.db"
  },
  "http": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3000,
    "path": "/webhook",
    "allowedEvents": ["dns.name","ip.addr","host.up"],
    "auth": {
      "type": "apiKey",
      "header": "authorization",
      "scheme": "Bearer",
      "token": "env:WEBHOOK_TOKEN"
    }
  }
}